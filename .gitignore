# Godot 4
.godot/
*.translation

# .uid files are NOT ignored. Godot 4.4+ writes one per script and resource, and
# they are what keeps references stable when a file is renamed or moved. Ignoring
# them makes every clone regenerate different IDs and breaks scene references.

# Generated content — reproducible from tools/, never committed
assets/generated/

# GDExtension build artifacts
.sconsign.dblite
.sconf_temp/
config.log
*.os
*.obj
*.o
*.so
*.dylib
*.dll
*.lib
*.pdb
*.exp
*.a
bin/

# Godot export output
build/
export/

# Blender
*.blend1
*.blend2

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Look-dev stills — render output, reproducible from tools/shots/shoot.sh
shots/

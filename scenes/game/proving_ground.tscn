[gd_scene load_steps=2 format=3]

; Almost empty on purpose, the same as scenes/look/kartview.tscn: everything is
; built by scripts/game/proving_ground.gd from command-line parameters, so a
; driving session or a still is described completely by the command that started
; it rather than by editor state. The kart it spawns is loaded at run time from
; assets/generated/kart.glb, which is gitignored and regenerated by
; tools/blender/genkart.sh — a hard ext_resource here would make the scene fail
; to load on a fresh clone.

[ext_resource type="Script" path="res://scripts/game/proving_ground.gd" id="1_proving_ground"]

[node name="ProvingGround" type="Node3D"]
script = ExtResource("1_proving_ground")

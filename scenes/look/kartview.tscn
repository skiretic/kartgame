[gd_scene load_steps=2 format=3]

; Intentionally almost empty, for the same reason scenes/look/lookdev.tscn is:
; everything is built by scripts/look/kartview.gd from command-line parameters,
; so a turntable is reproducible from the command that made it rather than from
; editor state. The kart it shows is loaded at run time from
; assets/generated/kart.glb, which is gitignored and regenerated by
; tools/blender/genkart.sh -- so this scene deliberately holds no reference to
; it. A hard ext_resource here would make the scene fail to load on a fresh
; clone, which is the trap ADR-0022 hit with .lmbake files.

[ext_resource type="Script" path="res://scripts/look/kartview.gd" id="1_kartview"]

[node name="KartView" type="Node3D"]
script = ExtResource("1_kartview")
